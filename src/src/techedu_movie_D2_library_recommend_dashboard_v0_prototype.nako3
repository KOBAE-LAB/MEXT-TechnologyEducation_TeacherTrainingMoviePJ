    # 条件を変えると，おすすめ本が変わる。
    選んだジャンル = 「物語」
    選んだ読み方 = 「じっくり」

    「選んだ条件」を表示。
    「ジャンル：{選んだジャンル}」を表示。
    「読み方：{選んだ読み方}」を表示。
    「」を表示。

    最高点 = -1
    おすすめタイトル = 「」
    おすすめ理由 = 「」
    おすすめ選定理由 = 「」

    本表を反復
        行 = 対象

        本タイトル = 行[0]
        本ジャンル = 行[1]
        本読み方 = 行[2]
        本おすすめ理由 = 行[3]

        点数 = 0
        合った理由 = 「」

        もし，本ジャンル = 選んだジャンルならば
            点数 = 点数 + 1
            合った理由 = 合った理由 & 「ジャンルが合っている，」
        ここまで

        もし，本読み方 = 選んだ読み方ならば
            点数 = 点数 + 1
            合った理由 = 合った理由 & 「読み方が合っている，」
        ここまで

        もし，点数 > 最高点ならば
            最高点 = 点数
            おすすめタイトル = 本タイトル
            おすすめ理由 = 本おすすめ理由
            おすすめ選定理由 = 合った理由
        ここまで
    ここまで

    「=== あなたへのおすすめ本 ===」を表示。
